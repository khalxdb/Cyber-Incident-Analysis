        <mxCell id="XgvtgvcX9Otd0rLqoro9-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;Backup-isolation weakness&lt;br&gt;&lt;/b&gt;Backups were not properly isolated from the compromised network and were affected by the breach.&lt;br&gt;&lt;br&gt;&lt;code style=&quot;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Fliegelman and Stemp, 2024, p. 6&lt;/font&gt;&lt;/code&gt;" vertex="1">
