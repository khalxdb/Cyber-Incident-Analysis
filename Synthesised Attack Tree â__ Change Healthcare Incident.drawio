        <mxCell id="XgvtgvcX9Otd0rLqoro9-80" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#4C0099);" value="&lt;blockquote&gt;&lt;p class=&quot;PDq2pG_selectionAnchorContainer&quot;&gt;&lt;strong&gt;Victim response:&lt;/strong&gt; UnitedHealth’s CEO authorised payment of a ransom.&lt;br&gt;&lt;br&gt;&lt;code&gt;Witty, 2024, p.3&lt;/code&gt;&lt;span aria-hidden=&quot;true&quot; class=&quot;PDq2pG_selectionAnchor&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;/blockquote&gt;&lt;br&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="200" width="370" x="1010" y="730" as="geometry" />
        </mxCell>
        <mxCell id="XgvtgvcX9Otd0rLqoro9-81" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#4C0099);" value="&lt;strong&gt;Context&lt;/strong&gt;&lt;br&gt;&lt;br&gt;Change Healthcare operated as a critical claims-processing provider and potential single point of failure for the US healthcare system.&lt;br&gt;&lt;br&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;Fliegelman and Stemp, 2024, pp. 1–3, 5&lt;/font&gt;&lt;/code&gt;" vertex="1">
          <mxGeometry height="140" width="190" x="560" y="60" as="geometry" />
        </mxCell>
        <mxCell id="XgvtgvcX9Otd0rLqoro9-82" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#4C0099);" value="&lt;strong&gt;Limited alternatives&lt;/strong&gt;&lt;br&gt;Some payers lacked automated backup payment systems, while exclusivity arrangements and high switching costs restricted alternative claims-processing routes.&lt;br&gt;&lt;br&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;Fliegelman and Stemp, 2024, p. 5&lt;/font&gt;&lt;/code&gt;" vertex="1">
          <mxGeometry height="140" width="200" x="750" y="60" as="geometry" />
        </mxCell>
        <mxCell id="XgvtgvcX9Otd0rLqoro9-83" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#331A00);" value="&lt;span&gt;Use potential further disclosure of stolen information as extortion leverage&lt;/span&gt;&lt;br&gt;&lt;br/&gt;&lt;code&gt;I-M, Witty, 2024, p.3; UnitedHealth Group, 2024, n.p.&lt;/code&gt;" vertex="1">
