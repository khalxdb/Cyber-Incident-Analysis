        <mxCell id="XgvtgvcX9Otd0rLqoro9-73" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;Recovery-planning weakness&lt;br&gt;&lt;/b&gt;Change Healthcare lacked a recovery plan with well-rehearsed procedures for minimising downtime.&lt;br&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;Fliegelman and Stemp, 2024, p. 6&lt;/font&gt;&lt;/code&gt;" vertex="1">
