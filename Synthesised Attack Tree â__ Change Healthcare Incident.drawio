        <mxCell id="XgvtgvcX9Otd0rLqoro9-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#808080);" value="CONFIDENTIALITY IMPACT&lt;br&gt;Change Healthcare reported to OCR that approximately 192.7 million individuals were affected.&lt;br&gt;&lt;br&gt;&lt;code&gt;&lt;font face=&quot;Helvetica&quot;&gt;R-H, HHS OCR, 2025, FAQ 11&lt;/font&gt;&lt;/code&gt;" vertex="1">
          <mxGeometry height="90" width="220" x="490" y="755" as="geometry" />
