        <mxCell id="XgvtgvcX9Otd0rLqoro9-76" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#1A3300);" value="Demand ransom payment from Change Healthcare&lt;br&gt;&lt;br&gt;&lt;code style=&quot;&quot;&gt;R-H, Witty, 2024, p.3&lt;/code&gt;" vertex="1">
