        <mxCell id="xta5ETJHjGwa7LrN_Mvo-172" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=light-dark(#FFFFFF,#331A00);" value="&lt;div style=&quot;line-height: 90%;&quot;&gt;&lt;h2 class=&quot;PDq2pG_selectionAnchorContainer&quot; style=&quot;line-height: 90%;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; line-height: 90%;&quot;&gt;HSE governance weakness:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal; line-height: 90%;&quot;&gt;The HSE lacked a CISO, centralised cybersecurity function and an adequately exercised cyber-incident plan.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; font-weight: normal; line-height: 90%;&quot;&gt;[HSE], R-H, PWC, pp.47–49&lt;/span&gt;&lt;/font&gt;&lt;/h2&gt;&lt;blockquote&gt;&lt;/blockquote&gt;&lt;/div&gt;" vertex="1">
